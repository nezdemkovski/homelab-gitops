{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    ":timezone(Europe/Prague)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  hostRules: [
    {
      description: "Authenticate against private GHCR images and charts",
      matchHost: "ghcr.io",
      hostType: "docker",
      username: "{{ secrets.GHCR_USERNAME }}",
      password: "{{ secrets.GHCR_TOKEN }}",
    },
  ],
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge own images and charts on every release",
      matchDatasources: ["docker"],
      matchPackageNames: ["/^ghcr\\.io/nezdemkovski//", "/^ghcr\\.io/amela-io//"],
      matchUpdateTypes: ["major", "minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: false,
    },
    // Upstream updates merge on their own once Flate renders the whole
    // cluster, so a PR only appears when that check fails
    {
      description: "Auto-merge upstream patch releases after they settle",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["!/^ghcr\\.io/nezdemkovski//", "!/^ghcr\\.io/amela-io//"],
      matchUpdateTypes: ["patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      // 0.x minors may break, so the presets treat them as majors
      description: "Auto-merge upstream minor releases after they settle",
      matchDatasources: ["docker", "helm"],
      matchPackageNames: ["!/^ghcr\\.io/nezdemkovski//", "!/^ghcr\\.io/amela-io//"],
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "!/^v?0\\./",
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge Renovate Presets",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // Grouping rules: one branch per deployed stack, so a stack never runs
    // half-updated. Majors get their own `major-<stack>` branch.

    { groupName: "amela", matchFileNames: ["apps/amela/**"] },
    { groupName: "auth", matchFileNames: ["apps/auth/**"] },
    { groupName: "forgejo", matchFileNames: ["apps/forgejo/**"] },
    { groupName: "haymaker", matchFileNames: ["apps/haymaker/**"] },
    { groupName: "homarr", matchFileNames: ["apps/homarr/**"] },
    { groupName: "monitoring", matchFileNames: ["apps/monitoring/**", "charts/monitoring/**"] },
    { groupName: "n8n", matchFileNames: ["apps/n8n/**"] },
    { groupName: "openmarkers", matchFileNames: ["apps/openmarkers/**"] },
    { groupName: "paperclip", matchFileNames: ["apps/paperclip/**", "charts/paperclip/**"] },
    { groupName: "plausible", matchFileNames: ["apps/plausible/**"] },
    { groupName: "supabase", matchFileNames: ["apps/supabase/**"] },
    { groupName: "uptime-kuma", matchFileNames: ["apps/uptime-kuma/**", "charts/uptime-kuma/**"] },
    { groupName: "cilium", matchFileNames: ["infrastructure/cilium/**"] },
    { groupName: "cloudflared", matchFileNames: ["infrastructure/cloudflared/**", "charts/cloudflared/**"] },
    { groupName: "cloudnative-pg", matchFileNames: ["infrastructure/cloudnative-pg/**"] },
    { groupName: "external-secrets", matchFileNames: ["infrastructure/external-secrets/**"] },
    { groupName: "local-path-provisioner", matchFileNames: ["infrastructure/local-path-provisioner/**"] },
    { groupName: "metrics-server", matchFileNames: ["infrastructure/metrics-server/**"] },
    { groupName: "onepassword-connect", matchFileNames: ["infrastructure/onepassword-connect/**"] },

    // Shared by every CloudNativePG cluster, so they move together
    {
      groupName: "postgresql",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/cloudnative-pg/postgresql"],
    },

    // Own releases deploy on their own cadence: grouping them with upstream
    // updates would hold an automerge behind a manual review
    { groupName: "amela release", matchFileNames: ["apps/amela/**"], matchPackageNames: ["/^ghcr\\.io/nezdemkovski//", "/^ghcr\\.io/amela-io//"] },
    { groupName: "auth release", matchFileNames: ["apps/auth/**"], matchPackageNames: ["/^ghcr\\.io/nezdemkovski//", "/^ghcr\\.io/amela-io//"] },
    { groupName: "haymaker release", matchFileNames: ["apps/haymaker/**"], matchPackageNames: ["/^ghcr\\.io/nezdemkovski//", "/^ghcr\\.io/amela-io//"] },
    { groupName: "openmarkers release", matchFileNames: ["apps/openmarkers/**"], matchPackageNames: ["/^ghcr\\.io/nezdemkovski//", "/^ghcr\\.io/amela-io//"] },
    // Majors wait for a checkbox on the Dependency Dashboard instead of
    // opening a PR on their own; own releases are exempt
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: ["!/^ghcr\\.io/nezdemkovski//", "!/^ghcr\\.io/amela-io//"],
      dependencyDashboardApproval: true,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
